APP_ENV=local
APP_PORT=8000

# Fill in the local PostgreSQL password before running migrations.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/bank_regulatory

# Local file storage is used first. MinIO can be enabled later.
STORAGE_BACKEND=local
STORAGE_ROOT=../storage

# Optional queue and object storage settings for the next phase.
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=CHANGE_ME
MINIO_SECRET_KEY=CHANGE_ME

# Qwen values will be provided later and must remain server-side.
QWEN_BASE_URL=
QWEN_API_KEY=
QWEN_CHAT_MODEL=
QWEN_EMBEDDING_MODEL=
QWEN_RERANK_MODEL=
